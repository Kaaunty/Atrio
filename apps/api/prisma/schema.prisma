enum MedicalCertificateReasonCategory {
  CONSULTA
  EXAME
  DOENCA_ATE_15D
  DOENCA_SUPERIOR_15D
  ACIDENTE_TRABALHO
  MATERNIDADE
  ACOMPANHAMENTO_FAMILIAR
  DOACAO_SANGUE
  OUTROS
}

enum MedicalCertificateStatus {
  ENVIADO
  EM_ANALISE_RH
  APROVADO
  REJEITADO
  SOLICITADO_CORRECAO
}

enum LeaveType {
  ATESTADO_MEDICO
  LICENCA_MATERNIDADE
  LICENCA_PATERNIDADE
  AUXILIO_DOENCA_INSS
  ACIDENTE_TRABALHO_INSS
  LICENCA_NAO_REMUNERADA
  OUTRO
}

model MedicalCertificate {
  id             String                           @id @default(uuid())
  employeeId     String                           @map("employee_id")
  startDate      DateTime                         @map("start_date") @db.Date
  daysCount      Int                              @map("days_count")
  endDate        DateTime                         @map("end_date") @db.Date
  issueDate      DateTime                         @map("issue_date") @db.Date
  doctorName     String                           @map("doctor_name")
  crmNumber      String                           @map("crm_number")
  cidCode        String?                          @map("cid_code")
  reasonCategory MedicalCertificateReasonCategory @default(DOENCA_ATE_15D) @map("reason_category")
  notes          String?                          @db.Text
  documentUrl    String                           @map("document_url")
  status         MedicalCertificateStatus         @default(ENVIADO)

  // Trilha de Homologação do RH
  rhReviewerId   String?                          @map("rh_reviewer_id")
  rhReviewNotes  String?                          @map("rh_review_notes") @db.Text
  reviewedAt     DateTime?                        @map("reviewed_at")

  createdAt      DateTime                         @default(now()) @map("created_at")
  updatedAt      DateTime                         @updatedAt @map("updated_at")

  employee       Employee                         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  rhReviewer     User?                            @relation("RhCertificateReviews", fields: [rhReviewerId], references: [id], onDelete: SetNull)
  leaves         LeaveOfAbsence[]

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([rhReviewerId])
  @@map("medical_certificates")
}

model LeaveOfAbsence {
  id                   String              @id @default(uuid())
  employeeId           String              @map("employee_id")
  medicalCertificateId String?             @map("medical_certificate_id")
  leaveType            LeaveType           @map("leave_type")
  startDate            DateTime            @map("start_date") @db.Date
  endDate              DateTime?           @map("end_date") @db.Date
  returnDate           DateTime?           @map("return_date") @db.Date
  inssReferral         Boolean             @default(false) @map("inss_referral")
  active               Boolean             @default(true)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  employee             Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  medicalCertificate   MedicalCertificate? @relation(fields: [medicalCertificateId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([leaveType])
  @@index([startDate])
  @@index([endDate])
  @@index([active])
  @@map("leaves_of_absence")
}

// -----------------------------------------------------------------------------
// CENTRAL DE DOCUMENTOS DO COLABORADOR (ETAPA 10)
// -----------------------------------------------------------------------------

enum DocumentVisibility {
  PRIVATE_EMPLOYEE_RH
  DEPARTMENT
  COMPANY_WIDE
}

model DocumentType {
  id                           String             @id @default(uuid())
  name                         String
  code                         String             @unique
  isInstitutional              Boolean            @default(false) @map("is_institutional")
  requiresReadAcknowledgement Boolean            @default(false) @map("requires_read_acknowledgement")
  createdAt                    DateTime           @default(now()) @map("created_at")
  updatedAt                    DateTime           @updatedAt @map("updated_at")

  documents                    EmployeeDocument[]

  @@map("document_types")
}

model EmployeeDocument {
  id             String             @id @default(uuid())
  documentTypeId String             @map("document_type_id")
  employeeId     String?            @map("employee_id")
  title          String
  description    String?            @db.Text
  fileUrl        String             @map("file_url")
  fileName       String             @map("file_name")
  fileSize       Int                @map("file_size")
  mimeType       String             @map("mime_type")
  referenceMonth Int?               @map("reference_month")
  referenceYear  Int?               @map("reference_year")
  expirationDate DateTime?          @map("expiration_date") @db.Date
  visibility     DocumentVisibility @default(PRIVATE_EMPLOYEE_RH)
  departmentId   String?            @map("department_id")
  uploadedBy     String?            @map("uploaded_by")

  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")

  documentType   DocumentType       @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  employee       Employee?          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department     Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  uploader       User?              @relation("UserUploadedDocuments", fields: [uploadedBy], references: [id], onDelete: SetNull)
  readReceipts   DocumentReadReceipt[]

  @@index([employeeId])
  @@index([documentTypeId])
  @@index([visibility])
  @@index([departmentId])
  @@index([referenceYear, referenceMonth])
  @@map("employee_documents")
}

model DocumentReadReceipt {
  id             String           @id @default(uuid())
  documentId     String           @map("document_id")
  employeeId     String           @map("employee_id")
  acknowledgedAt DateTime         @default(now()) @map("acknowledged_at")
  ipAddress      String?          @map("ip_address")
  userAgent      String?          @map("user_agent")

  document       EmployeeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([documentId, employeeId])
  @@index([documentId])
  @@index([employeeId])
  @@map("document_read_receipts")
}

// -----------------------------------------------------------------------------
